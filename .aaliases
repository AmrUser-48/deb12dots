# Text search
greg () {
    if [ "$#" -eq 0 ]; then
        grep --color=always | less
    else
        grep --color=always "$@" | less
    fi
}

ftext () {
grep -iIHrn --color=always "$1" . | less -R -r
}

mkd () {
if [[ ! -d $1 ]]
    then
mkdir -p "$1" && cd "$1"
else
    mkdir -p "$1"2 && cd "$1"2
fi
}

gtr () {
    #перекладач. буфер може містити ім'я файлу
    #або дані, які будуть відповідно оброблені.
    # також перевіряється аргумент, він також може бути фацлом, або даними
    #якщо аргумент не! пустий
    # ClipBoard
   #G_PRIMARY="$(xsel --primary --output)"
   #G_SECONDARY="$(xsel --secondary --output)"
   #G_CLIPBD="$(xsel --clipboard --output)"
    Trans_Temp="$(xsel -o)"
if [[ ! -z "$*" ]]
  then
    #якщо аргумент існуючий файл
    if [[ -f "$*" ]]
    then
        echo translating file "$*"
        trans :uk -b -i "$*"
    else
        echo translating argument "$*"
        trans :uk -b "$*"
    #вихід після успішного завершення - крах конструкуії
    return 0
    fi
#інакше, якщо змінна, це існуючий файл
elif [[ -f $Trans_Temp ]]
    then
    #переклад файлу ім'я якого взято з буферу обміну
    echo translating file clip "$Trans_Temp"
    trans :uk -b -i "$Trans_Temp"
    return 0
#інакше, якщо значення змінної не співпадає з існуючим файлом
elif [[ ! -f $Trans_Temp ]]
  then
        #тоді - перекласти дані з буферу, якщо його значення не зеро
    if [[ ! -z $Trans_Temp ]]
    then
        echo -e "$Trans_Temp" "\n"
        trans :uk -b "$Trans_Temp"
    fi
fi
}

gsearch () {
links -dump  \
    'https://google.com/search?q="$*"' \
    | less
}

