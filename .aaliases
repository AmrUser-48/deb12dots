# VIFM
vicd ()
{
  local dest=$(vifm --choose-dir - "$@")

  if [ $? -eq 0 ]; then
    cd "$dest"
  fi
}


# Save command (ahahahhah)
a () {
echo "$*" >> $HOME/.saved_commands
}

save-commans () {
echo "$*" >> $HOME/.saved_commands
}
alias A='less $HOME/.saved_commands'

