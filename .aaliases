# if runnimn bash
if [ "$0" = "bash" ]; then
    eval "$(lesspipe)"
    alias src='source ~/.bashrc'
    alias ashow='less ~/.bash_aliases'
fi

# if runnimn zsh
if [ -n "$ZSH_VERSION" ]; then
    alias src='source ~/.zshrc'
    elif [ -f ~/.aaliases ]; then
    alias ashow='less ~/.bash_aliases'
fi

