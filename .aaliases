#PROMPT_DIRTRIM=1
#
# -----------------------------------------------------------------------------
# Shared Bash/Zsh setup
#
# Version variables identify the shell even when this file is sourced.
if [ -n "\${BASH_VERSION:-}" ]; then
    if command -v lesspipe >/dev/null 2>&1; then
        eval "$(SHELL=/bin/sh lesspipe)"
    fi
    alias src='source ~/.bashrc'
elif [ -n "\${ZSH_VERSION:-}" ]; then
    alias src='source ~/.zshrc'
fi
alias ashow='less ~/.aaliases'

# -----------------------------------------------------------------------------
# General commands and text tools
#   colors
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias g='grep --color=always -i'
alias o='fg '
alias j='jobs'
alias c='clear'
alias m='less -RmI '
#alias m='less -MIR'
alias q='tldr '
alias bat='batcat --theme "Solarized (dark)"'

# -----------------------------------------------------------------------------
# Package maintenance
alias ac='sudo apt autoremove -y ; sudo apt clean'

# -----------------------------------------------------------------------------
# Processes, system status, and diagnostics
alias df='df -h'
alias t='pstree -h'
alias hop='htop'
alias freq='watch -n.1 cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq'
alias showtime='watch -n1 date "+%F\ \ %B\ %A\ %H:%M:%S"'
alias w='free -h ; df -h /'
alias dmesg='sudo dmesg'
alias msrread='sudo rdmsr -a 0x1a0 ; sudo rdmsr -a 0x19a ; sudo rdmsr -a 0x199 ; sudo rdmsr -a 0x198'

# -----------------------------------------------------------------------------
# Network and connections
# Keeps the effective ss alias from the original file.
alias s='ss -tpn'

# -----------------------------------------------------------------------------
# Filesystem and navigation
# Directory listings
alias l='ls --group-directories-first -Ashtr '
alias ll='ls -lAFht --group-directories-first'

# File operations
alias rd='rm -fvr '
alias rm='rm -v'
alias md='mkdir -vp '
alias cp='cp -v'
alias mkdir='mkdir -pv'
alias mv='mv -v'

# Parent directories and common folders
alias ..='cd ../ '
alias ...='cd ../../ '
alias cdGIT='cd ~/Documents/GIT/'
alias cdd='cd ~/Downloads/'
alias cdc='cd ~/Documents/'
alias cdm='cd ~/Music/'
alias cdp='cd ~/Pictures/'
alias cd.='cd ~/.config/'
alias cdb='cd ~/bin/'

# -----------------------------------------------------------------------------
# Editors and configuration
#alias vi='busybox vi'
alias vi='sudo -E nvim '
alias acfg='nvim -n ~/.aaliases'
#alias acfg='nvim -n ~/.bash_aliases'
alias bcfg='nvim -n --noplugin ~/.bashrc'
alias zcfg='nvim ~/.zshrc'
alias vcfg='nvim ~/.vim/vimrc'
alias ncfg='nvim ~/.config/nvim/init.vim'
alias nv='nvim'
alias historybakup='gzip -kc  ~/.bash_history > ~/.bash_history_$(date +%Y-%m-%d-%H-%M).gz'

# -----------------------------------------------------------------------------
# Desktop, input devices, and Android
# Tg / Telegram Desktop
alias tsd='PREV=$(xdotool getactivewindow) && wmctrl -xa "TelegramDesktop" && sleep 0.2 && xdotool key ctrl+v && sleep 0.2 && xdotool key Return && wmctrl -i -a $PREV'
# Gamepad
alias gamepademulator="sudo /home/jeroen/pipi/bin/python3 ~/mygamepad.uinpyt.py"
# adb
alias tethering-on="adb shell 'am start -n com.android.settings/.TetherSettings && input keyevent 20 20 20 20 KEYCODE_ENTER 4'"
# Display calibration
alias xcalib_c='xcalib -c ; xcalib -co 84 -a'
#alias xcalib_c='xcalib -c ; xcalib -co 84 -a'
#alias restart-game="adb shell 'am force-stop com.panzerdog.tacticool && am start -n com.panzerdog.tacticool/.androidtacticoolhelper.TacticoolActivity'"

# -----------------------------------------------------------------------------
# Video downloads, playback, and clipboard
#porn aliases
alias ydb='yt-dlp -f best $(xclip -o)'
alias ydp7='yt-dlp -f hls-720p $(xclip -o)'
alias yd4p='yt-dlp -f hls-480p $(xclip -o)'
alias mpp='mpv --no-audio --ytdl-format=mp4-low $(xclip -o)'
# Clipbd
alias ppaste='xclip -selection "primary" -o'

# -----------------------------------------------------------------------------
# Audio, plotting, and music
alias sox='sox_ng'
alias soxi='soxi_ng'
alias play='play_ng'
alias brown='sox -c2 -b16 -r 44100 -n -d synth -n 79200 br'
alias plotting='sox --plot gnuplot -n -n equalizer 1000 .8k -8 | gnuplot -p >& /dev/null'
alias rncmpcpp='ncmpcpp -h 192.168.0.70 -p 8600'

# -----------------------------------------------------------------------------
# Applications and user settings
alias ai='aichat ; printf "\e[?12l"'
#alias aichat='aichat; printf "\e[?12l"'
#alias aichat-ng='aichat; printf "\e[?12l"'
alias creset='printf "\e[?12l"'
