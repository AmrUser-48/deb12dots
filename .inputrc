$include /etc/inputrc

# -_
set completion-map-case on

#####################
# do not bell on tab-completion
set bell-style none

##To preserve cursor position when navigating command history (e.g., to avoid moving the cursor manually after pressing ↑), enable history-preserve-point in your ~/.inputrc:

set history-preserve-point on

# Be 8 bit clean.
    #set input-meta on
    #set output-meta on
# Allow UTF-8 input and output, instead of showing stuff like $'\0123\0456'
#    set convert-meta off

# Key binds from bash
#    #bind '"\e[A": history-search-backward'
#    #bind '"\e[B": history-search-forward'
#    bind '"\e[C": forward-char'
#    bind '"\e[D": backward-char'
#"\e[5~": backward-word   #pageup
#"\e[6~": forward-word    #pagedown
#    bind '"\e[3;3~": kill-word'     #altdel
#    #bind '"\e[29~": quoted-insert' #menu
#    bind "set completion-ignore-case on"
#    #bind '"\e[29~": "\C-c"'
#
# history up down
#"\e[B": history-search-forward
#"\e[A": history-search-backward



# some defaults / modifications for the emacs mode
$if mode=emacs

# allow the use of the Home/End keys
"\e[1~": beginning-of-line
"\e[2~": quoted-insert

# allow the use of the Delete/Insert keys
"\e[3~": delete-char
"\e[4~": end-of-line

# mappings for Ctrl-left-arrow and Ctrl-right-arrow for word moving 
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[5C": forward-word
"\e[5D": backward-word

# history up down
#"\e[B": history-search-forward
#"\e[A": history-search-backward

"\e[8~": end-of-line

$endif

# zsh like completion:
# https://superuser.com/questions/288714/bash-autocomplete-like-zsh
#set show-all-if-ambiguous on
#TAB:menu-complete
#too much

"\[5~": backward-word
"\[6~": forward-word


#https://raw.githubusercontent.com/dominee/Termux-dotfiles/master/.inputrc
# Make Tab autocomplete regardless of filename case
set completion-ignore-case on


# Immediately add a trailing slash when autocompleting symlinks to directories
set mark-symlinked-directories on

# Use the text that has already been typed as the prefix for searching through
# commands (i.e. more intelligent Up/Down behavior)
#"\e[B": history-search-forward
#"\e[A": history-search-backward

# ctrl left, ctrl right for moving on the readline by word
#"\e[1;5C": forward-word
#"\e[1;5D": backward-word

# Do not autocomplete hidden files unless the pattern explicitly begins with a dot
#set match-hidden-files off

# Show all autocomplete results at once off if annoying  :todo cant disable why?
set page-completions on


# If there are more than 200 possible completions for a word, ask to show them all
set completion-query-items 200

# Show extra file information when completing, like `ls -F` does
set visible-stats on

# Be more intelligent when autocompleting by also looking at the text after
# the cursor. For example, when the current line is "cd ~/src/mozil", and
# the cursor is on the "z", pressing Tab will not autocomplete it to "cd
# ~/src/mozillail", but to "cd ~/src/mozilla". (This is supported by the
# Readline used by Bash 4.)
#set skip-completed-text on

# Use Alt/Meta + Delete to delete the preceding word
"\e[3;3~": kill-word
"\eg": "your-function-here"
